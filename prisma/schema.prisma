// Prisma schema for the personal dashboard.
// area/status/priority/frequency are plain strings rather than native Postgres
// enums, so the allowed values live in one place: src/types/index.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER") // "SUPER_ADMIN" | "USER"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedTasks             Task[]                 @relation("TaskOwner")
  assignedTasks          Task[]                 @relation("TaskAssignee")
  taskCollaborations     TaskCollaborator[]
  ownedProjects          Project[]              @relation("ProjectOwner")
  projectCollaborations  ProjectCollaborator[]
  notes                  Note[]
  habits                 Habit[]
  documents              Document[]
  timezoneEntries        TimezoneEntry[]
  weatherLocations       WeatherLocation[]
  notificationRecipients NotificationRecipient[]
  pushSubscriptions      PushSubscription[]
  tenderRules            TenderRule[]
  tenderMatches          TenderMatch[]
  priceItems             PriceItem[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  area        String // "BUSINESS" | "PERSONAL"
  status      String    @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE"
  priority    String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  dueDate     DateTime?
  order       Int       @default(0)
  aiGenerated Boolean   @default(false)

  ownerId String?
  owner   User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  collaborators TaskCollaborator[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  parentTaskId String?
  parentTask   Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[] @relation("TaskSubtasks")

  notes Note[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([area, status])
  @@index([projectId])
  @@index([parentTaskId])
  @@index([dueDate])
  @@index([ownerId])
  @@index([assigneeId])
}

model TaskCollaborator {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  area        String // "BUSINESS" | "PERSONAL"
  status      String    @default("ACTIVE") // "PLANNED" | "ACTIVE" | "ON_HOLD" | "COMPLETED"
  color       String?
  dueDate     DateTime?
  order       Int       @default(0)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  collaborators ProjectCollaborator[]

  tasks Task[]
  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area, status])
  @@index([ownerId])
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
}

model Note {
  id      String  @id @default(cuid())
  title   String
  content String // markdown
  area    String // "BUSINESS" | "PERSONAL"
  tags    String? // comma-separated
  pinned  Boolean @default(false)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area])
  @@index([ownerId])
}

model Habit {
  id                String  @id @default(cuid())
  name              String
  area              String // "BUSINESS" | "PERSONAL"
  frequency         String  @default("DAILY") // "DAILY" | "WEEKLY" | "CUSTOM"
  targetDaysPerWeek Int?
  daysOfWeek        String? // "MON,WED,FRI" — used when frequency = CUSTOM
  color             String?
  active            Boolean @default(true)
  order             Int     @default(0)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  logs HabitLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area, active])
  @@index([ownerId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime // normalized to UTC midnight, see src/lib/dates.ts
  completed Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([date])
}

model Document {
  id             String    @id @default(cuid())
  name           String // e.g. "Driver's License", "Passport"
  category       String    @default("OTHER") // "LICENSE" | "PASSPORT" | "INSURANCE" | "REGISTRATION" | "VISA" | "OTHER"
  area           String // "BUSINESS" | "PERSONAL"
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  notes          String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area])
  @@index([expiryDate])
  @@index([ownerId])
}

model NotificationRecipient {
  id           String   @id @default(cuid())
  label        String?
  email        String?
  whatsapp     String? // E.164, e.g. +15551234567
  dailyDigest  Boolean  @default(true)
  weeklyDigest Boolean  @default(true)
  priceReport  Boolean  @default(false) // morning competitor price comparison email
  active       Boolean  @default(true)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model TimezoneEntry {
  id       String @id @default(cuid())
  label    String // e.g. "New York"
  timezone String // IANA name, e.g. "America/New_York"
  order    Int    @default(0)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ownerId])
}

model WeatherLocation {
  id        String @id @default(cuid())
  label     String // e.g. "Johannesburg, South Africa"
  latitude  Float
  longitude Float
  order     Int    @default(0)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ownerId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tender {
  id            String    @id @default(cuid())
  // Which portal this row came from: "ETENDERS" | "GAUTENG_HEALTH" | "VHEMBE"
  // (see TENDER_SOURCES in src/types/index.ts). externalId is only unique
  // per-source — reference-number formats differ and could otherwise collide.
  source        String    @default("ETENDERS")
  externalId    String // tender/bid reference from the source portal (e.g. "GT/GDH/020/2026")
  title         String // description / bid title from the source
  category      String? // eTenders category list; null for other sources
  province      String?
  department    String?
  tenderType    String? // e.g. "Open Tender", "RFQ", "Request for Proposal"
  publishedDate DateTime?
  closingDate   DateTime?
  briefingDate  DateTime?
  briefingVenue String?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  documents     Json? // [{ fileName, url }]
  sourceUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches TenderMatch[]

  @@unique([source, externalId])
  @@index([closingDate])
  @@index([category])
  @@index([province])
  @@index([source])
}

model TenderRule {
  id         String   @id @default(cuid())
  label      String
  keywords   String[] @default([]) // matched case-insensitively against title/category
  categories String[] @default([]) // exact category names from eTenders, OR'd
  provinces  String[] @default([]) // South African province names, OR'd
  active     Boolean  @default(true)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  matches TenderMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model TenderMatch {
  id       String     @id @default(cuid())
  tenderId String
  tender   Tender     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  ruleId   String
  rule     TenderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tenderId, ruleId])
  @@index([ownerId])
}

// Price compare: one PriceItem per product the user tracks, with a link to their
// own product page (isMine) plus links to the same product on competitor sites.
model PriceItem {
  id        String @id @default(cuid())
  name      String
  costPrice Float? // what the user pays for the product, entered by hand

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  links PriceLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model PriceLink {
  id     String    @id @default(cuid())
  itemId String
  item   PriceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url    String
  isMine Boolean   @default(false)

  // Latest check. price is null until the first successful read; error holds
  // the reason the most recent check failed (the last good price is kept).
  price        Float?
  regularPrice Float?
  title        String?
  inStock      Boolean?
  error        String?
  checkedAt    DateTime?

  points PricePoint[]

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([checkedAt])
}

// One price per link per day, for trends and "changed since yesterday".
model PricePoint {
  id     String    @id @default(cuid())
  linkId String
  link   PriceLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD (Africa/Johannesburg)
  price  Float

  @@unique([linkId, day])
}
